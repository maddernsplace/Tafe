{
  "name": "tafe-study-dashboard",
  "productName": "TAFE Study Dashboard",
  "version": "1.7.3",
  "description": "Personal AI-ready TAFE study vault",
  "author": "TAFE Student",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "vite build && electron-builder",
    "build:electron:dir": "vite build && electron-builder --dir",
    "electron:preview": "vite build && electron .",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "date-fns": "^3.3.1",
    "electron": "^30.0.2",
    "electron-builder": "^24.13.3",
    "idb": "^8.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "vite": "^5.1.0"
  },
  "build": {
    "appId": "au.tafe.studydashboard",
    "productName": "TAFE Study Dashboard",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "maddernsplace",
      "repo": "tafe",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAFE Study Dashboard"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  }
}
